---
import Layout from '../layouts/Layout.astro';
import GridBackground from '../shared/components/GridBackground.astro';
import BadgeWheel from '../shared/components/BadgeWheel.astro';
import Contact from '../shared/components/Contact.astro';
import { site } from '../config/site';
import { yearsExperience } from '../shared/utils/config';

const years = yearsExperience(site);

const badgeItems = [
  { label: 'Automation', icon: '/images/badge-automation.svg' },
  { label: 'Data & Reporting', icon: '/images/badge-dataviz.svg' },
  { label: 'Performance', icon: '/images/badge-performance.svg' },
  { label: 'API Integrations', icon: '/images/badge-api.svg' },
  { label: 'Scalable Systems', icon: '/images/badge-security.svg' },
  { label: 'Modern Frameworks', icon: '/images/badge-react.svg' },
  { label: 'Serverless Architecture', icon: '/images/badge-plugin.svg' },
];
---

<Layout>
  <!-- Hero -->
  <section id="hero" class="hero">
    <GridBackground />
    <div class="hero-inner section-container">
      <div class="hero-row">
        <div class="hero-content">
          <p class="hero-label">A ChuckAllen.dev Company</p>
          <h1 class="hero-title">
            Practical Systems.<br />
            <span class="hero-accent">Built to Last.</span>
          </h1>
          <ul class="hero-points">
            <li><span class="hero-icon" aria-hidden="true">🤖</span>Automation that eliminates busywork</li>
            <li><span class="hero-icon" aria-hidden="true">📊</span>Data systems that surface what matters</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 50 50" fill="none" aria-hidden="true"><!-- Rotate everything 45deg clockwise around center --><g transform="rotate(45 25 25)"><!-- Left curly cord --><path d="M-4 25 Q2 21 5 25 Q8 29 11 25" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" fill="none"/><!-- Female body: tapers wider toward face --><path d="M11 20.5 L11 29.5 Q11 31 12 31 L21 33 Q22 33 22 32 L22 18 Q22 17 21 17 L12 19 Q11 19 11 20.5Z" stroke="#f97316" stroke-width="1.5" fill="none" stroke-linejoin="round"/><!-- Female face: receptacle slots --><rect x="21.5" y="21" width="1" height="3" rx="0.5" fill="#f97316"/><rect x="21.5" y="26" width="1" height="3" rx="0.5" fill="#f97316"/><!-- Male prongs --><line x1="28" y1="22" x2="25" y2="22" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><line x1="28" y1="28" x2="25" y2="28" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><circle cx="25.5" cy="25" r="0.7" fill="#f97316"/><!-- Male body --><path d="M39 20.5 L39 29.5 Q39 31 38 31 L29 33 Q28 33 28 32 L28 18 Q28 17 29 17 L38 19 Q39 19 39 20.5Z" stroke="#f97316" stroke-width="1.5" fill="none" stroke-linejoin="round"/><!-- Right curly cord --><path d="M39 25 Q42 21 45 25 Q48 29 54 25" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" fill="none"/></g></svg>Integrations that don't break</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="17" stroke="#1e3a1e" stroke-width="3"/><circle cx="20" cy="20" r="17" stroke="#0cce6b" stroke-width="3" stroke-dasharray="106.8" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-90 20 20)"/><text x="20" y="24" text-anchor="middle" fill="#0cce6b" font-size="13" font-weight="700">100</text></svg>Performance as a requirement</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="3" y="3" width="34" height="34" rx="3" stroke="#5b9bd5" stroke-width="1.5"/><line x1="3" y1="11" x2="37" y2="11" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="3" y1="19" x2="37" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="3" y1="27" x2="37" y2="27" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="11" y1="3" x2="11" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="19" y1="3" x2="19" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="27" y1="3" x2="27" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><rect x="11" y="11" width="16" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><rect x="7" y="23" width="10" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><rect x="21" y="23" width="12" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><line x1="19" y1="19" x2="19" y2="23" stroke="#5b9bd5" stroke-width="1.5"/><line x1="12" y1="23" x2="19" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.6"/><line x1="27" y1="23" x2="19" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.6"/></svg>Architecture that scales</li>
            <li><span class="hero-icon" aria-hidden="true">🧠</span>AI where it actually makes sense</li>
          </ul>
          <p class="hero-closer">{years}+ years of engineering for agencies, startups, and enterprise teams.</p>
          <div class="hero-actions">
            <a href="/#contact" class="btn-primary">Get Started</a>
            <a href="/#services" class="btn-outline">What We Do</a>
          </div>
        </div>
        <div class="hero-wheel">
          <BadgeWheel items={badgeItems} checkmarkIcon="/images/badge-checkmark.svg" />
        </div>
      </div>
    </div>
    <div class="hero-marquee-mobile">
      <BadgeWheel items={badgeItems} />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="section-container">
      <h2 class="section-title">What We Build</h2>
      <p class="section-subtitle">
        Production-grade systems. No experiments, no hype — things that work.
      </p>
      <div class="services-grid">
        <div class="service-card card">
          <h3 class="service-name">Custom Web Development</h3>
          <p class="service-desc">Astro, Next.js, Vue, React, Node — modern frameworks built for performance and maintainability.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Automation & Workflows</h3>
          <p class="service-desc">Eliminate repetitive work. Business processes that run themselves — reliably, at scale.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Data & Reporting</h3>
          <p class="service-desc">Dashboards, real-time reporting, and data pipelines that turn complexity into clarity.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">API Integrations</h3>
          <p class="service-desc">Google, ShipStation, payment gateways, and custom connectors. Multi-step orchestration that just works.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Alerts & Notifications</h3>
          <p class="service-desc">Context-aware alerts that surface what matters. No noise, no missed signals, no wasted attention.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Scalable Architecture</h3>
          <p class="service-desc">Serverless, edge-deployed, built for growth. Infrastructure that scales without rearchitecting.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Work / Portfolio -->
  <section id="work" class="section">
    <GridBackground blobColor="rgba(234,88,12,0.05)" />
    <div class="section-container">
      <h2 class="section-title">Selected Work</h2>
      <p class="section-subtitle">
        Case studies and demos coming soon.
      </p>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="section-container">
      <h2 class="section-title">About</h2>
      <div class="about-content">
        <p>ChuckAllen.ai is the company behind <a href="https://mrwpress.com">MR. WPress</a>, <a href="https://chuckallen.dev">ChuckAllen.dev</a>, and future ventures. It represents over {years} years of building for the web — custom development, WordPress engineering, API integrations, automation, and performance-first architecture.</p>
        <p>We build practical systems that run in production, handle edge cases, and scale with your business. Not proofs of concept. Not trend-chasing. Real engineering with AI and automation applied where they genuinely solve problems.</p>
        <p>Based in Colorado. Available during US business hours. We work with agencies, dev teams, and companies that need senior technical execution — not another junior freelancer.</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <Contact
    site={site}
    title="Let's Build Something That Works"
    subtitle="Ready to start a project? Pick the way that works best for you."
  />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 140px 0 80px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero {
      padding: 180px 0 40px;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .hero-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 60px;
    }
  }

  .hero-content {
    flex: 1;
  }

  .hero-wheel {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero-wheel {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      min-height: 500px;
    }
  }

  .hero-marquee-mobile {
    position: relative;
    z-index: 1;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .hero-marquee-mobile {
      display: none;
    }
  }

  .hero-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent-light);
    margin-bottom: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: 36px;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 24px;
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 48px; }
  }
  @media (min-width: 1024px) {
    .hero-title { font-size: 64px; }
  }

  .hero-accent {
    color: var(--color-accent-light);
  }

  .hero-points {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-points {
      gap: 1rem 2.5rem;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-points {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-points li {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  @media (min-width: 768px) {
    .hero-points li { font-size: 1.125rem; }
  }

  .hero-icon {
    font-size: 2.25rem;
    flex-shrink: 0;
  }

  .hero-icon-svg {
    width: 2.25rem;
    height: 2.25rem;
  }

  .hero-closer {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .hero-closer {
      font-size: 18px;
      margin-bottom: 2.5rem;
    }
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ── Sections ── */
  .section {
    position: relative;
    padding: 64px 0;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .section {
      padding: 96px 0;
    }
  }

  .section-title {
    font-size: 30px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 12px;
  }
  @media (min-width: 768px) {
    .section-title { font-size: 36px; }
  }
  @media (min-width: 1024px) {
    .section-title { font-size: 48px; }
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 16px;
    max-width: 600px;
    margin-bottom: 48px;
  }
  @media (min-width: 768px) {
    .section-subtitle { font-size: 18px; }
  }

  /* ── Services Grid ── */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    padding: 24px;
    transition: border-color 0.2s ease;
  }
  .service-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .service-name {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .service-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ── About ── */
  .about-content {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--color-text-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .about-content a {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .about-content a:hover {
    color: var(--color-text);
  }
  @media (min-width: 768px) {
    .about-content { font-size: 17px; }
  }
</style>
