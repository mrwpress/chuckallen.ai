---
import Layout from '../layouts/Layout.astro';
import GridBackground from '../shared/components/GridBackground.astro';
import BadgeWheel from '../shared/components/BadgeWheel.astro';
import Contact from '../shared/components/Contact.astro';
import { site } from '../config/site';
import { yearsExperience } from '../shared/utils/config';

const years = yearsExperience(site);

const badgeItems = [
  { label: 'Automation', icon: '/images/badge-automation.svg' },
  { label: 'Data & Reporting', icon: '/images/badge-dataviz.svg' },
  { label: 'Performance', icon: '/images/badge-performance.svg' },
  { label: 'API Integrations', icon: '/images/badge-api.svg' },
  { label: 'Scalable Systems', icon: '/images/badge-security.svg' },
  { label: 'Modern Frameworks', icon: '/images/badge-react.svg' },
  { label: 'Serverless Architecture', icon: '/images/badge-plugin.svg' },
];
---

<Layout>
  <!-- Hero -->
  <section id="hero" class="hero">
    <GridBackground />
    <div class="hero-inner section-container">
      <div class="hero-row">
        <div class="hero-content">
          <p class="hero-label">A ChuckAllen.dev Company</p>
          <h1 class="hero-title">
            Practical Systems.<br />
            <span class="hero-accent">Built to Last.</span>
          </h1>
          <ul class="hero-points">
            <li><span class="hero-icon" aria-hidden="true">🤖</span>Automation that eliminates busywork</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><!-- Pie chart (left) --><circle cx="12" cy="20" r="9" stroke="#f97316" stroke-width="1.5"/><path d="M12 20 L12 11 A9 9 0 0 1 20.4 16.5 Z" fill="#f97316" opacity="0.6"/><path d="M12 20 L20.4 16.5 A9 9 0 0 1 15.5 28.5 Z" fill="#f97316" opacity="0.3"/><!-- Bar chart (right) --><rect x="25" y="22" width="3.5" height="8" rx="0.5" fill="#f97316" opacity="0.4"/><rect x="30" y="16" width="3.5" height="14" rx="0.5" fill="#f97316" opacity="0.6"/><rect x="35" y="19" width="3.5" height="11" rx="0.5" fill="#f97316" opacity="0.8"/></svg>Data systems that surface what matters</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 50 50" fill="none" aria-hidden="true"><!-- Rotate everything 45deg clockwise around center --><g transform="rotate(45 25 25)"><!-- Left curly cord --><path d="M-4 25 Q2 21 5 25 Q8 29 11 25" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" fill="none"/><!-- Female body: tapers wider toward face --><path d="M11 20.5 L11 29.5 Q11 31 12 31 L21 33 Q22 33 22 32 L22 18 Q22 17 21 17 L12 19 Q11 19 11 20.5Z" stroke="#f97316" stroke-width="1.5" fill="none" stroke-linejoin="round"/><!-- Female face: receptacle slots --><rect x="21.5" y="21" width="1" height="3" rx="0.5" fill="#f97316"/><rect x="21.5" y="26" width="1" height="3" rx="0.5" fill="#f97316"/><!-- Male prongs --><line x1="28" y1="22" x2="25" y2="22" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><line x1="28" y1="28" x2="25" y2="28" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><circle cx="25.5" cy="25" r="0.7" fill="#f97316"/><!-- Male body --><path d="M39 20.5 L39 29.5 Q39 31 38 31 L29 33 Q28 33 28 32 L28 18 Q28 17 29 17 L38 19 Q39 19 39 20.5Z" stroke="#f97316" stroke-width="1.5" fill="none" stroke-linejoin="round"/><!-- Right curly cord --><path d="M39 25 Q42 21 45 25 Q48 29 54 25" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" fill="none"/></g></svg>Integrations that don't break</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="17" stroke="#1e3a1e" stroke-width="3"/><circle cx="20" cy="20" r="17" stroke="#0cce6b" stroke-width="3" stroke-dasharray="106.8" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-90 20 20)"/><text x="20" y="24" text-anchor="middle" fill="#0cce6b" font-size="13" font-weight="700">100</text></svg>Performance as a requirement</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="3" y="3" width="34" height="34" rx="3" stroke="#5b9bd5" stroke-width="1.5"/><line x1="3" y1="11" x2="37" y2="11" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="3" y1="19" x2="37" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="3" y1="27" x2="37" y2="27" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="11" y1="3" x2="11" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="19" y1="3" x2="19" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="27" y1="3" x2="27" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><rect x="11" y="11" width="16" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><rect x="7" y="23" width="10" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><rect x="21" y="23" width="12" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><line x1="19" y1="19" x2="19" y2="23" stroke="#5b9bd5" stroke-width="1.5"/><line x1="12" y1="23" x2="19" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.6"/><line x1="27" y1="23" x2="19" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.6"/></svg>Architecture that scales</li>
            <li><span class="hero-icon" aria-hidden="true">🧠</span>AI where it actually makes sense</li>
          </ul>
          <p class="hero-closer">{years}+ years of engineering for agencies, startups, and enterprise teams.</p>
          <div class="hero-actions">
            <a href="/#contact" class="btn-primary">Get Started</a>
            <a href="/#services" class="btn-outline">What We Do</a>
          </div>
        </div>
        <div class="hero-wheel">
          <BadgeWheel items={badgeItems} checkmarkIcon="/images/badge-checkmark.svg" />
        </div>
      </div>
    </div>
    <div class="hero-marquee-mobile">
      <BadgeWheel items={badgeItems} />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="section-container">
      <h2 class="section-title">Sound Familiar?</h2>
      <p class="section-subtitle">
        Maybe it's the report someone rebuilds by hand every Monday. The API that breaks every time a vendor pushes an update. The AI tool that was supposed to change everything but never left the pilot phase. Here's how I fix that.
      </p>
      <div class="services-grid">
        <div class="service-card card">
          <h3 class="service-name">Automation That Actually Runs</h3>
          <p class="service-desc">How many hours does your team spend on work a script could handle? I build workflows, scheduled tasks, and process automation that eliminate the repetitive stuff — and keep running without babysitting.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">AI Where It Helps, Not Where It Hypes</h3>
          <p class="service-desc">Tried an AI tool that promised the world and delivered a demo? I help teams figure out where AI genuinely solves a problem — then build it into production, not a slide deck.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Data You Can Actually Act On</h3>
          <p class="service-desc">When your numbers live in spreadsheets, inboxes, and three different dashboards, nobody trusts any of them. I build real-time reporting and pipelines that give your team one source of truth.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Integrations That Survive Updates</h3>
          <p class="service-desc">Duct-taped API connections fail silently. I build robust integrations — payment gateways, shipping APIs, CRMs, custom connectors — with error handling and monitoring baked in.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Alerts That Mean Something</h3>
          <p class="service-desc">Too many alerts and your team ignores them all. Too few and problems slip through. I build context-aware notifications that surface what matters — before your customers notice.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Architecture That Doesn't Need Rebuilding</h3>
          <p class="service-desc">Growing shouldn't mean starting over. Serverless, edge-deployed, built for the traffic you have today and the traffic you're planning for — without ten times the infrastructure cost.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section id="work" class="section">
    <GridBackground blobColor="rgba(234,88,12,0.05)" />
    <div class="section-container">
      <h2 class="section-title">Results, Not Résumé Lines</h2>
      <p class="section-subtitle">
        Full case studies are on the way. In the meantime, here's what the work actually looks like.
      </p>
      <div class="results-grid">
        <div class="result-item card">
          <span class="result-number">12 hrs/week</span>
          <p class="result-label">Saved by automating a manual reporting workflow for a 50-person operations team</p>
        </div>
        <div class="result-item card">
          <span class="result-number">Real-time</span>
          <p class="result-label">Custom dashboards replacing spreadsheet-based tracking for logistics and fulfillment</p>
        </div>
        <div class="result-item card">
          <span class="result-number">Zero downtime</span>
          <p class="result-label">Serverless architecture handling 10x traffic spikes without manual intervention</p>
        </div>
        <div class="result-item card">
          <span class="result-number">Seconds, not hours</span>
          <p class="result-label">Automated lead response and routing replacing a 42-hour average reply time</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="section-container">
      <h2 class="section-title">Built Different on Purpose</h2>
      <div class="about-row">
      <div class="about-visual" id="about-visual">
        <svg class="flow-svg" viewBox="0 0 280 504" fill="none" aria-hidden="true">
          <!--
            Dev Pipeline Flow — 8px grid, center spine x=140
            Rows: 0, 88, 176, 272, 360, 464
            Nodes: 120×40, rx=8. Row 3 (data) is taller: 56px with sub-badges.
            Logos: simple-icons paths scaled to fit r=11 circles
          -->

          <!-- ── Connectors ── -->
          <!-- Row 1 splits to Row 2 pair -->
          <path class="flow-line fl-1" d="M140 40 L140 56 Q140 64 132 64 L88 64 Q80 64 80 72 L80 88" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-1" d="M140 40 L140 56 Q140 64 148 64 L192 64 Q200 64 200 72 L200 88" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 2 pair merges to Row 3 -->
          <path class="flow-line fl-2" d="M80 128 L80 144 Q80 152 88 152 L132 152 Q140 152 140 160 L140 176" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-2" d="M200 128 L200 144 Q200 152 192 152 L148 152 Q140 152 140 160 L140 176" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 3 to Row 4 -->
          <line class="flow-line fl-3" x1="140" y1="232" x2="140" y2="272" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 4 splits to Row 5 pair -->
          <path class="flow-line fl-4" d="M140 312 L140 328 Q140 336 132 336 L88 336 Q80 336 80 344 L80 360" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-4" d="M140 312 L140 328 Q140 336 148 336 L192 336 Q200 336 200 344 L200 360" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 5 pair merges to Row 6 -->
          <path class="flow-line fl-5" d="M64 400 L64 420 Q64 428 72 428 L132 428 Q140 428 140 436 L140 444" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-5" d="M216 400 L216 420 Q216 428 208 428 L148 428 Q140 428 140 436 L140 444" stroke="var(--color-accent-light)" stroke-width="1.5"/>

          <!-- ── Row 1: AI-Assisted Planning (centered) ── -->
          <g class="flow-node fn-1">
            <rect x="44" y="0" width="192" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <circle cx="68" cy="20" r="11" fill="var(--color-accent)" opacity="0.2"/>
            <text x="68" y="24" text-anchor="middle" fill="var(--color-accent-light)" font-size="9" font-weight="700" font-family="var(--font-sans)">AI</text>
            <text x="152" y="24" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">AI-Assisted Planning</text>
          </g>

          <!-- ── Row 2: Astro + React/Next (pair with logos) ── -->
          <g class="flow-node fn-2">
            <rect x="12" y="88" width="120" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <circle cx="32" cy="108" r="11" fill="var(--color-accent)" opacity="0.2"/>
            <!-- Astro logo -->
            <g transform="translate(22,98) scale(0.83)">
              <path d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165zm-5.961-4.445s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z" fill="var(--color-accent-light)"/>
            </g>
            <text x="84" y="112" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">Astro</text>
          </g>
          <g class="flow-node fn-2">
            <rect x="148" y="88" width="120" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <circle cx="168" cy="108" r="11" fill="var(--color-accent)" opacity="0.2"/>
            <!-- React logo (simplified atom) -->
            <g transform="translate(160,100)">
              <circle cx="8" cy="8" r="1.8" fill="var(--color-accent-light)"/>
              <ellipse cx="8" cy="8" rx="7.5" ry="3" stroke="var(--color-accent-light)" stroke-width="0.8" fill="none"/>
              <ellipse cx="8" cy="8" rx="7.5" ry="3" stroke="var(--color-accent-light)" stroke-width="0.8" fill="none" transform="rotate(60 8 8)"/>
              <ellipse cx="8" cy="8" rx="7.5" ry="3" stroke="var(--color-accent-light)" stroke-width="0.8" fill="none" transform="rotate(120 8 8)"/>
            </g>
            <text x="224" y="112" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">React / Next</text>
          </g>

          <!-- ── Row 3: Data Layer (centered, taller with 3 badges) ── -->
          <g class="flow-node fn-3">
            <rect x="28" y="176" width="224" height="56" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <text x="140" y="192" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">Data Layer</text>
            <!-- Three sub-badges -->
            <rect x="40" y="200" width="56" height="22" rx="4" fill="var(--color-accent)" fill-opacity="0.12" stroke="var(--color-accent-light)" stroke-width="0.75"/>
            <text x="68" y="215" text-anchor="middle" fill="var(--color-accent-light)" font-size="8" font-weight="700" font-family="var(--font-sans)">AWS</text>
            <rect x="104" y="200" width="72" height="22" rx="4" fill="var(--color-accent)" fill-opacity="0.12" stroke="var(--color-accent-light)" stroke-width="0.75"/>
            <text x="140" y="215" text-anchor="middle" fill="var(--color-accent-light)" font-size="8" font-weight="700" font-family="var(--font-sans)">Supabase</text>
            <rect x="184" y="200" width="56" height="22" rx="4" fill="var(--color-accent)" fill-opacity="0.12" stroke="var(--color-accent-light)" stroke-width="0.75"/>
            <text x="212" y="215" text-anchor="middle" fill="var(--color-accent-light)" font-size="8" font-weight="700" font-family="var(--font-sans)">CF D1</text>
          </g>

          <!-- ── Row 4: GitHub (centered with logo) ── -->
          <g class="flow-node fn-4">
            <rect x="44" y="272" width="192" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <circle cx="68" cy="292" r="11" fill="var(--color-accent)" opacity="0.2"/>
            <!-- GitHub logo (24×24 path scaled to ~16px, centered in circle) -->
            <g transform="translate(60,284) scale(0.67)">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" fill="var(--color-accent-light)"/>
            </g>
            <text x="152" y="296" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">GitHub CI/CD</text>
          </g>

          <!-- ── Row 5: CF Pages + CF Workers (pair with logos) ── -->
          <g class="flow-node fn-5">
            <rect x="4" y="360" width="120" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <circle cx="24" cy="380" r="11" fill="var(--color-accent)" opacity="0.2"/>
            <!-- Cloudflare logo (24×24 path scaled to fit circle) -->
            <g transform="translate(14,372) scale(0.7)">
              <path d="M16.5088 16.8447c.1475-.5068.0908-.9707-.1553-1.3154-.2246-.3164-.6045-.499-1.0615-.5205l-8.6592-.1123a.1559.1559 0 0 1-.1333-.0713c-.0283-.042-.0351-.0986-.021-.1553.0278-.084.1123-.1484.2036-.1562l8.7359-.1123c1.0351-.0489 2.1601-.8868 2.5537-1.9136l.499-1.3013c.0215-.0561.0293-.1128.0147-.168-.5625-2.5463-2.835-4.4453-5.5499-4.4453-2.5039 0-4.6284 1.6177-5.3876 3.8614-.4927-.3658-1.1187-.5625-1.794-.499-1.2026.119-2.1665 1.083-2.2861 2.2856-.0283.31-.0069.6128.0635.894C1.5683 13.171 0 14.7754 0 16.752c0 .1748.0142.3515.0352.5273.0141.083.0844.1475.1689.1475h15.9814c.0909 0 .1758-.0645.2032-.1553l.12-.4268zm2.7568-5.5634c-.0771 0-.1611 0-.2383.0112-.0566 0-.1054.0415-.127.0976l-.3378 1.1744c-.1475.5068-.0918.9707.1543 1.3164.2256.3164.6055.498 1.0625.5195l1.8437.1133c.0557 0 .1055.0263.1329.0703.0283.043.0351.1074.0214.1562-.0283.084-.1132.1485-.204.1553l-1.921.1123c-1.041.0488-2.1582.8867-2.5527 1.914l-.1406.3585c-.0283.0713.0215.1416.0986.1416h6.5977c.0771 0 .1474-.0489.169-.126.1122-.4082.1757-.837.1757-1.2803 0-2.6025-2.125-4.727-4.7344-4.727" fill="var(--color-accent-light)"/>
            </g>
            <text x="80" y="384" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">CF Pages</text>
          </g>
          <g class="flow-node fn-5">
            <rect x="156" y="360" width="120" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)"/>
            <circle cx="176" cy="380" r="11" fill="var(--color-accent)" opacity="0.2"/>
            <text x="176" y="384" text-anchor="middle" fill="var(--color-accent-light)" font-size="9" font-weight="700" font-family="var(--font-sans)">ƒx</text>
            <text x="228" y="384" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">CF Workers</text>
          </g>

          <!-- ── Row 6: Live on Edge (pill) ── -->
          <g class="flow-node fn-6">
            <rect x="76" y="444" width="128" height="32" rx="16" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-accent)" fill-opacity="0.15"/>
            <text x="140" y="464" text-anchor="middle" fill="var(--color-accent-light)" font-size="10" font-weight="700" font-family="var(--font-sans)">Live on Edge</text>
          </g>
        </svg>
      </div>
      <div class="about-content">
        <p>ChuckAllen.ai is the AI and automation arm of <a href="https://chuckallen.dev" target="_blank" rel="noopener">ChuckAllen.dev</a> — {years}+ years of engineering for agencies, startups, and enterprise teams. I also run <a href="https://mrwpress.com" target="_blank" rel="noopener">MR. WPress</a> for WordPress-specific work.</p>
        <p>I'm not an "AI company." I'm an engineer who uses AI and automation as tools — applied where they genuinely solve problems, not where they make a good headline. If a cron job and a well-written script solve it better than a language model, that's what I'll build.</p>
        <p>Based in Colorado. Available during US business hours. Calls, screen shares, Slack — whatever works for your team. White-label friendly.</p>
      </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <Contact
    site={site}
    title="Something Not Working the Way It Should?"
    subtitle="Tell me what's costing your team time. I'll tell you how to fix it — no pitch, no pressure."
  />
