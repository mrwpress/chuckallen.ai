<script>
  const svg = document.querySelector('.flow-svg') as SVGSVGElement | null;
  if (svg) {
    const spark = svg.querySelector('.flow-spark') as SVGCircleElement;
    const sparkB = svg.querySelector('.flow-spark-b') as SVGCircleElement;

    // Waypoints: the spark travels through these coordinates
    // Each step: { t: time(ms), x, y, node?: class to show, line?: class to draw, split?: true, merge?: true }
    const timeline = [
      // Row 1: AI Planning appears, spark starts
      { t: 0,    x: 160, y: 0,   node: 'fn-1' },
      { t: 200,  x: 160, y: 20 },
      // Split to frameworks (spark goes left, sparkB goes right)
      { t: 400,  x: 160, y: 40,  line: 'fl-1', split: true },
      { t: 600,  ax: 80, ay: 64, bx: 240, by: 64 },
      { t: 800,  ax: 40, ay: 88, bx: 280, by: 88, node: 'fn-2' },
      // Merge from frameworks: left pair→Data Layer, right pair→None
      { t: 1100, ax: 40,  ay: 128, bx: 280, by: 128, line: 'fl-2' },
      { t: 1400, ax: 108, ay: 176, bx: 260, by: 192, node: 'fn-3' },
      // Merge back into GitHub
      { t: 1800, ax: 128, ay: 232, bx: 260, by: 224, line: 'fl-3' },
      { t: 2100, ax: 160, ay: 272, bx: 160, by: 272, merge: true },
      // Row 4: GitHub
      { t: 2200, x: 160, y: 272, node: 'fn-4' },
      { t: 2400, x: 160, y: 312 },
      // Split to CF Pages / Workers
      { t: 2600, x: 160, y: 328, split: true, line: 'fl-4' },
      { t: 2800, ax: 120, ay: 352, bx: 200, by: 352 },
      { t: 3000, ax: 82,  ay: 376, bx: 238, by: 376, node: 'fn-5' },
      // Merge to deploy
      { t: 3300, ax: 76,  ay: 400, bx: 244, by: 400, line: 'fl-5' },
      { t: 3600, ax: 160, ay: 440, bx: 160, by: 440, merge: true },
      // Row 6: Live on Edge
      { t: 3800, x: 160, y: 460, node: 'fn-6' },
    ];

    const totalDuration = 4200;
    let animId: number | null = null;
    let loopTimer: ReturnType<typeof setTimeout> | null = null;
    let isSplit = false;

    function moveSpark(el: SVGCircleElement, x: number, y: number, opacity = 1) {
      el.setAttribute('cx', String(x));
      el.setAttribute('cy', String(y));
      el.setAttribute('opacity', String(opacity));
    }

    function hideSpark(el: SVGCircleElement) {
      el.setAttribute('opacity', '0');
    }

    function reset() {
      if (animId) { cancelAnimationFrame(animId); animId = null; }
      svg!.querySelectorAll('.flow-line').forEach((l) => l.classList.remove('drawn'));
      svg!.querySelectorAll('.flow-node').forEach((n) => {
        n.classList.remove('shown', 'pulse');
        // Reset border dashoffset
        n.querySelectorAll('rect[stroke-dashoffset], path[stroke-dashoffset]').forEach((shape) => {
          const da = shape.getAttribute('stroke-dasharray');
          if (da) (shape as SVGElement).style.strokeDashoffset = da;
        });
      });
      hideSpark(spark);
      hideSpark(sparkB);
      isSplit = false;
      const streams = svg!.querySelector('.flow-streams');
      if (streams) streams.classList.remove('active');
    }

    function draw() {
      reset();
      const start = performance.now();
      let stepIdx = 0;

      function tick(now: number) {
        const elapsed = now - start;

        // Process all steps that should have fired by now
        while (stepIdx < timeline.length && elapsed >= timeline[stepIdx].t) {
          const step = timeline[stepIdx] as any;

          // Show node: draw border, then fade in content
          if (step.node) {
            svg!.querySelectorAll(`.${step.node}`).forEach((el) => {
              // Animate the rect/path border drawing
              el.querySelectorAll('rect[stroke-dashoffset], path[stroke-dashoffset]').forEach((shape) => {
                (shape as SVGElement).style.strokeDashoffset = '0';
              });
              el.classList.add('shown', 'pulse');
              setTimeout(() => el.classList.remove('pulse'), 600);
            });
          }

          // Draw line
          if (step.line) {
            svg!.querySelectorAll(`.${step.line}`).forEach((el) => el.classList.add('drawn'));
          }

          // Handle split/merge
          if (step.split) isSplit = true;
          if (step.merge) {
            isSplit = false;
            // sparkB converged to same position as spark — hide it
            hideSpark(sparkB);
          }

          stepIdx++;
        }

        // Interpolate spark position between current and next step
        if (stepIdx < timeline.length) {
          const prev = (stepIdx > 0 ? timeline[stepIdx - 1] : timeline[0]) as any;
          const next = timeline[stepIdx] as any;
          const segStart = prev.t;
          const segEnd = next.t;
          const progress = segEnd > segStart ? Math.min((elapsed - segStart) / (segEnd - segStart), 1) : 1;

          // Normalize prev/next coords — handle x/y vs ax/ay/bx/by
          const px = prev.x ?? prev.ax ?? 140;
          const py = prev.y ?? prev.ay ?? 0;
          const pbx = prev.bx ?? prev.x ?? 140;
          const pby = prev.by ?? prev.y ?? 0;

          if (isSplit && next.ax !== undefined) {
            moveSpark(spark,
              px + (next.ax - px) * progress,
              py + (next.ay - py) * progress
            );
            moveSpark(sparkB,
              pbx + (next.bx - pbx) * progress,
              pby + (next.by - pby) * progress
            );
          } else {
            const nx = next.x ?? next.ax ?? 160;
            const ny = next.y ?? next.ay ?? 0;
            moveSpark(spark,
              px + (nx - px) * progress,
              py + (ny - py) * progress
            );
            hideSpark(sparkB);
          }
        }

        if (elapsed < totalDuration) {
          animId = requestAnimationFrame(tick);
        } else {
          // Fade sparks out, activate streams
          hideSpark(spark);
          hideSpark(sparkB);
          const streams = svg!.querySelector('.flow-streams');
          if (streams) streams.classList.add('active');
        }
      }

      animId = requestAnimationFrame(tick);
    }

    function startLoop() {
      draw();
      if (window.innerWidth >= 1040) {
        loopTimer = setInterval(() => {
          reset();
          setTimeout(draw, 400);
        }, 7000);
      }
    }

    function stopLoop() {
      if (loopTimer) { clearInterval(loopTimer); loopTimer = null; }
      if (animId) { cancelAnimationFrame(animId); animId = null; }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startLoop();
          } else {
            stopLoop();
            reset();
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(svg);
  }
</script>

