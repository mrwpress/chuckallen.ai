---
import Layout from '../layouts/Layout.astro';
import GridBackground from '../shared/components/GridBackground.astro';
import BadgeWheel from '../shared/components/BadgeWheel.astro';
import Contact from '../shared/components/Contact.astro';
import { site } from '../config/site';
import { yearsExperience } from '../shared/utils/config';

const years = yearsExperience(site);

const badgeItems = [
  { label: 'Automation', icon: '/images/badge-automation.svg' },
  { label: 'Data & Reporting', icon: '/images/badge-dataviz.svg' },
  { label: 'Performance', icon: '/images/badge-performance.svg' },
  { label: 'API Integrations', icon: '/images/badge-api.svg' },
  { label: 'Scalable Systems', icon: '/images/badge-security.svg' },
  { label: 'Modern Frameworks', icon: '/images/badge-react.svg' },
  { label: 'Serverless Architecture', icon: '/images/badge-plugin.svg' },
];
---

<Layout>
  <!-- Hero -->
  <section id="hero" class="hero">
    <GridBackground />
    <div class="hero-inner section-container">
      <div class="hero-row">
        <div class="hero-content">
          <p class="hero-label">A ChuckAllen.dev Company</p>
          <h1 class="hero-title">
            Practical Systems.<br />
            <span class="hero-accent">Built to Last.</span>
          </h1>
          <ul class="hero-points">
            <li><span class="hero-icon" aria-hidden="true">🤖</span>Automation that eliminates busywork</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><!-- Pie chart (left) --><circle cx="12" cy="20" r="9" stroke="#f97316" stroke-width="1.5"/><path d="M12 20 L12 11 A9 9 0 0 1 20.4 16.5 Z" fill="#f97316" opacity="0.6"/><path d="M12 20 L20.4 16.5 A9 9 0 0 1 15.5 28.5 Z" fill="#f97316" opacity="0.3"/><!-- Bar chart (right) --><rect x="25" y="22" width="3.5" height="8" rx="0.5" fill="#f97316" opacity="0.4"/><rect x="30" y="16" width="3.5" height="14" rx="0.5" fill="#f97316" opacity="0.6"/><rect x="35" y="19" width="3.5" height="11" rx="0.5" fill="#f97316" opacity="0.8"/></svg>Data systems that surface what matters</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 50 50" fill="none" aria-hidden="true"><!-- Rotate everything 45deg clockwise around center --><g transform="rotate(45 25 25)"><!-- Left curly cord --><path d="M-4 25 Q2 21 5 25 Q8 29 11 25" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" fill="none"/><!-- Female body: tapers wider toward face --><path d="M11 20.5 L11 29.5 Q11 31 12 31 L21 33 Q22 33 22 32 L22 18 Q22 17 21 17 L12 19 Q11 19 11 20.5Z" stroke="#f97316" stroke-width="1.5" fill="none" stroke-linejoin="round"/><!-- Female face: receptacle slots --><rect x="21.5" y="21" width="1" height="3" rx="0.5" fill="#f97316"/><rect x="21.5" y="26" width="1" height="3" rx="0.5" fill="#f97316"/><!-- Male prongs --><line x1="28" y1="22" x2="25" y2="22" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><line x1="28" y1="28" x2="25" y2="28" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><circle cx="25.5" cy="25" r="0.7" fill="#f97316"/><!-- Male body --><path d="M39 20.5 L39 29.5 Q39 31 38 31 L29 33 Q28 33 28 32 L28 18 Q28 17 29 17 L38 19 Q39 19 39 20.5Z" stroke="#f97316" stroke-width="1.5" fill="none" stroke-linejoin="round"/><!-- Right curly cord --><path d="M39 25 Q42 21 45 25 Q48 29 54 25" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" fill="none"/></g></svg>Integrations that don't break</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="17" stroke="#1e3a1e" stroke-width="3"/><circle cx="20" cy="20" r="17" stroke="#0cce6b" stroke-width="3" stroke-dasharray="106.8" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-90 20 20)"/><text x="20" y="24" text-anchor="middle" fill="#0cce6b" font-size="13" font-weight="700">100</text></svg>Performance as a requirement</li>
            <li><svg class="hero-icon hero-icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="3" y="3" width="34" height="34" rx="3" stroke="#5b9bd5" stroke-width="1.5"/><line x1="3" y1="11" x2="37" y2="11" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="3" y1="19" x2="37" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="3" y1="27" x2="37" y2="27" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="11" y1="3" x2="11" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="19" y1="3" x2="19" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><line x1="27" y1="3" x2="27" y2="37" stroke="#5b9bd5" stroke-width="1" opacity="0.4"/><rect x="11" y="11" width="16" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><rect x="7" y="23" width="10" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><rect x="21" y="23" width="12" height="8" rx="1" stroke="#5b9bd5" stroke-width="1.5"/><line x1="19" y1="19" x2="19" y2="23" stroke="#5b9bd5" stroke-width="1.5"/><line x1="12" y1="23" x2="19" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.6"/><line x1="27" y1="23" x2="19" y2="19" stroke="#5b9bd5" stroke-width="1" opacity="0.6"/></svg>Architecture that scales</li>
            <li><span class="hero-icon" aria-hidden="true">🧠</span>AI where it actually makes sense</li>
          </ul>
          <p class="hero-closer">{years}+ years of engineering for agencies, startups, and enterprise teams.</p>
          <div class="hero-actions">
            <a href="/#contact" class="btn-primary">Get Started</a>
            <a href="/#services" class="btn-outline">What We Do</a>
          </div>
        </div>
        <div class="hero-wheel">
          <BadgeWheel items={badgeItems} checkmarkIcon="/images/badge-checkmark.svg" />
        </div>
      </div>
    </div>
    <div class="hero-marquee-mobile">
      <BadgeWheel items={badgeItems} />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="section-container">
      <h2 class="section-title">Sound Familiar?</h2>
      <p class="section-subtitle">
        Maybe it's the report someone rebuilds by hand every Monday. The API that breaks every time a vendor pushes an update. The AI tool that was supposed to change everything but never left the pilot phase. Here's how I fix that.
      </p>
      <div class="services-grid">
        <div class="service-card card">
          <h3 class="service-name">Automation That Actually Runs</h3>
          <p class="service-desc">How many hours does your team spend on work a script could handle? I build workflows, scheduled tasks, and process automation that eliminate the repetitive stuff — and keep running without babysitting.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">AI Where It Helps, Not Where It Hypes</h3>
          <p class="service-desc">Tried an AI tool that promised the world and delivered a demo? I help teams figure out where AI genuinely solves a problem — then build it into production, not a slide deck.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Data You Can Actually Act On</h3>
          <p class="service-desc">When your numbers live in spreadsheets, inboxes, and three different dashboards, nobody trusts any of them. I build real-time reporting and pipelines that give your team one source of truth.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Integrations That Survive Updates</h3>
          <p class="service-desc">Duct-taped API connections fail silently. I build robust integrations — payment gateways, shipping APIs, CRMs, custom connectors — with error handling and monitoring baked in.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Alerts That Mean Something</h3>
          <p class="service-desc">Too many alerts and your team ignores them all. Too few and problems slip through. I build context-aware notifications that surface what matters — before your customers notice.</p>
        </div>
        <div class="service-card card">
          <h3 class="service-name">Architecture That Doesn't Need Rebuilding</h3>
          <p class="service-desc">Growing shouldn't mean starting over. Serverless, edge-deployed, built for the traffic you have today and the traffic you're planning for — without ten times the infrastructure cost.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section id="work" class="section">
    <GridBackground blobColor="rgba(234,88,12,0.05)" />
    <div class="section-container">
      <h2 class="section-title">Results, Not Résumé Lines</h2>
      <p class="section-subtitle">
        Full case studies are on the way. In the meantime, here's what the work actually looks like.
      </p>
      <div class="results-grid">
        <div class="result-item card">
          <span class="result-number">12 hrs/week</span>
          <p class="result-label">Saved by automating a manual reporting workflow for a 50-person operations team</p>
        </div>
        <div class="result-item card">
          <span class="result-number">Real-time</span>
          <p class="result-label">Custom dashboards replacing spreadsheet-based tracking for logistics and fulfillment</p>
        </div>
        <div class="result-item card">
          <span class="result-number">Zero downtime</span>
          <p class="result-label">Serverless architecture handling 10x traffic spikes without manual intervention</p>
        </div>
        <div class="result-item card">
          <span class="result-number">Seconds, not hours</span>
          <p class="result-label">Automated lead response and routing replacing a 42-hour average reply time</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="section-container">
      <h2 class="section-title about-title">Your Project Gets Senior Thinking From Day One</h2>
      <div class="about-row">
      <div class="about-visual" id="about-visual">
        <svg class="flow-svg" viewBox="0 0 320 504" fill="none" aria-hidden="true">
          <!-- Glow filter for spark -->
          <defs>
            <filter id="spark-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
            <radialGradient id="spark-grad">
              <stop offset="0%" stop-color="#fff"/>
              <stop offset="40%" stop-color="var(--color-accent-light)"/>
              <stop offset="100%" stop-color="var(--color-accent-light)" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <!-- Spark elements (positioned via JS) -->
          <circle class="flow-spark" r="5" fill="url(#spark-grad)" filter="url(#spark-glow)" opacity="0"/>
          <circle class="flow-spark-b" r="5" fill="url(#spark-grad)" filter="url(#spark-glow)" opacity="0"/>
          <!--
            Dev Pipeline Flow — 8px grid, center spine x=140
            Rows: 0, 88, 176, 272, 360, 464
            Nodes: 120×40, rx=8. Row 3 (data) is taller: 56px with sub-badges.
            Logos: simple-icons paths scaled to fit r=11 circles
          -->

          <!-- ── Connectors ── -->
          <!-- Row 1 splits to Row 2 (four frameworks) -->
          <path class="flow-line fl-1" d="M160 40 L160 56 Q160 64 152 64 L48 64 Q40 64 40 72 L40 88" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-1" d="M160 40 L160 56 Q160 64 152 64 L128 64 Q120 64 120 72 L120 88" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-1" d="M160 40 L160 56 Q160 64 168 64 L192 64 Q200 64 200 72 L200 88" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-1" d="M160 40 L160 56 Q160 64 168 64 L272 64 Q280 64 280 72 L280 88" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 2 merges: Astro + React merge left to Data Layer, Next + Vue merge right to None -->
          <path class="flow-line fl-2" d="M40 128 L40 148 Q40 156 48 156 L100 156 Q108 156 108 164 L108 176" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-2" d="M120 128 L120 140 Q120 148 112 148 L116 148 Q108 148 108 156 L108 176" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-2" d="M200 128 L200 140 Q200 148 208 148 L252 148 Q260 148 260 156 L260 192" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-2" d="M280 128 L280 148 Q280 156 272 156 L268 156 Q260 156 260 164 L260 192" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Data Layer (left) merges with None (right) into GitHub -->
          <path class="flow-line fl-3" d="M128 232 L128 248 Q128 256 136 256 L152 256 Q160 256 160 264 L160 272" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-3" d="M260 224 L260 248 Q260 256 252 256 L168 256 Q160 256 160 264 L160 272" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 4 (GitHub) splits to Row 5 pair -->
          <path class="flow-line fl-4" d="M160 312 L160 328 Q160 336 152 336 L100 336 Q92 336 92 344 L92 360" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-4" d="M160 312 L160 328 Q160 336 168 336 L220 336 Q228 336 228 344 L228 360" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <!-- Row 5 pair merges to Row 6 -->
          <path class="flow-line fl-5" d="M76 400 L76 420 Q76 428 84 428 L152 428 Q160 428 160 436 L160 444" stroke="var(--color-accent-light)" stroke-width="1.5"/>
          <path class="flow-line fl-5" d="M244 400 L244 420 Q244 428 236 428 L168 428 Q160 428 160 436 L160 444" stroke="var(--color-accent-light)" stroke-width="1.5"/>

          <!-- ── Flow streams (energy pulses down the pipes) ── -->
          <g class="flow-streams">
            <!-- Row 1→2 streams -->
            <path class="flow-stream fs-1" d="M160 40 L160 56 Q160 64 152 64 L48 64 Q40 64 40 72 L40 88" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-1b" d="M160 40 L160 56 Q160 64 152 64 L128 64 Q120 64 120 72 L120 88" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-1c" d="M160 40 L160 56 Q160 64 168 64 L192 64 Q200 64 200 72 L200 88" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-1d" d="M160 40 L160 56 Q160 64 168 64 L272 64 Q280 64 280 72 L280 88" stroke="var(--color-accent-light)" stroke-width="2"/>
            <!-- Row 2→3 streams (all four) -->
            <path class="flow-stream fs-2" d="M40 128 L40 148 Q40 156 48 156 L100 156 Q108 156 108 164 L108 176" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-2b" d="M120 128 L120 140 Q120 148 112 148 L116 148 Q108 148 108 156 L108 176" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-2c" d="M200 128 L200 140 Q200 148 208 148 L252 148 Q260 148 260 156 L260 192" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-2d" d="M280 128 L280 148 Q280 156 272 156 L268 156 Q260 156 260 164 L260 192" stroke="var(--color-accent-light)" stroke-width="2"/>
            <!-- Row 3→4 streams -->
            <path class="flow-stream fs-3" d="M128 232 L128 248 Q128 256 136 256 L152 256 Q160 256 160 264 L160 272" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-3b" d="M260 224 L260 248 Q260 256 252 256 L168 256 Q160 256 160 264 L160 272" stroke="var(--color-accent-light)" stroke-width="2"/>
            <!-- Row 4→5 streams -->
            <path class="flow-stream fs-4" d="M160 312 L160 328 Q160 336 152 336 L100 336 Q92 336 92 344 L92 360" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-4b" d="M160 312 L160 328 Q160 336 168 336 L220 336 Q228 336 228 344 L228 360" stroke="var(--color-accent-light)" stroke-width="2"/>
            <!-- Row 5→6 streams -->
            <path class="flow-stream fs-5" d="M76 400 L76 420 Q76 428 84 428 L152 428 Q160 428 160 436 L160 444" stroke="var(--color-accent-light)" stroke-width="2"/>
            <path class="flow-stream fs-5b" d="M244 400 L244 420 Q244 428 236 428 L168 428 Q160 428 160 436 L160 444" stroke="var(--color-accent-light)" stroke-width="2"/>
          </g>

          <!-- ── Row 1: AI-Assisted Planning (centered) ── -->
          <!-- Perimeter: 2*(192+40) - 4*8 + 4*(2*pi*8/4) ≈ 464 - 32 + 50 ≈ 482 -->
          <g class="flow-node fn-1">
            <rect x="64" y="0" width="192" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)" stroke-dasharray="450" stroke-dashoffset="450"/>
            <g class="node-content">
              <circle cx="88" cy="20" r="11" fill="#a855f7" opacity="0.25"/>
              <text x="88" y="24" text-anchor="middle" fill="#c084fc" font-size="9" font-weight="700" font-family="var(--font-sans)">AI</text>
              <text x="172" y="24" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">AI-Assisted Planning</text>
            </g>
          </g>

          <!-- ── Row 2: Astro + React + Next + Vue ── -->
          <g class="flow-node fn-2">
            <rect x="4" y="88" width="72" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)" stroke-dasharray="210" stroke-dashoffset="210"/>
            <g class="node-content">
              <circle cx="20" cy="108" r="11" fill="#ffffff" opacity="0.1"/>
              <g transform="translate(11,99) scale(0.75)"><path d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165zm-5.961-4.445s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z" fill="#ffffff"/></g>
              <text x="50" y="112" text-anchor="middle" fill="white" font-size="9" font-weight="600" font-family="var(--font-sans)">Astro</text>
            </g>
          </g>
          <g class="flow-node fn-2">
            <rect x="84" y="88" width="72" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)" stroke-dasharray="210" stroke-dashoffset="210"/>
            <g class="node-content">
              <circle cx="100" cy="108" r="11" fill="#61DAFB" opacity="0.15"/>
              <g transform="translate(92,100)"><circle cx="8" cy="8" r="1.6" fill="#61DAFB"/><ellipse cx="8" cy="8" rx="7" ry="2.8" stroke="#61DAFB" stroke-width="0.7" fill="none"/><ellipse cx="8" cy="8" rx="7" ry="2.8" stroke="#61DAFB" stroke-width="0.7" fill="none" transform="rotate(60 8 8)"/><ellipse cx="8" cy="8" rx="7" ry="2.8" stroke="#61DAFB" stroke-width="0.7" fill="none" transform="rotate(120 8 8)"/></g>
              <text x="136" y="112" text-anchor="middle" fill="white" font-size="9" font-weight="600" font-family="var(--font-sans)">React</text>
            </g>
          </g>
          <g class="flow-node fn-2">
            <rect x="164" y="88" width="72" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)" stroke-dasharray="210" stroke-dashoffset="210"/>
            <g class="node-content">
              <circle cx="180" cy="108" r="11" fill="#ffffff" opacity="0.08"/>
              <g transform="translate(173,101) scale(0.55)"><path d="M18.665 21.978C16.758 23.255 14.465 24 12 24 5.377 24 0 18.623 0 12S5.377 0 12 0s12 5.377 12 12c0 3.583-1.574 6.801-4.067 9.001L9.219 7.2H7.2v9.596h1.615V9.251l9.85 12.727Zm-3.332-8.533 1.6 2.061V7.2h-1.6v6.245Z" fill="#ffffff"/></g>
              <text x="216" y="112" text-anchor="middle" fill="white" font-size="9" font-weight="600" font-family="var(--font-sans)">Next.js</text>
            </g>
          </g>
          <g class="flow-node fn-2">
            <rect x="244" y="88" width="72" height="40" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)" stroke-dasharray="210" stroke-dashoffset="210"/>
            <g class="node-content">
              <circle cx="260" cy="108" r="11" fill="#42b883" opacity="0.15"/>
              <g transform="translate(252,100) scale(0.6)"><path d="M24,1.61H14.06L12,5.16,9.94,1.61H0L12,22.39ZM12,14.08,5.16,2.23H9.59L12,6.41l2.41-4.18h4.43Z" fill="#42b883"/></g>
              <text x="296" y="112" text-anchor="middle" fill="white" font-size="9" font-weight="600" font-family="var(--font-sans)">Vue</text>
            </g>
          </g>

          <!-- ── Row 3 Left: Data Layer ── -->
          <g class="flow-node fn-3">
            <rect x="4" y="176" width="228" height="56" rx="8" stroke="var(--color-accent-light)" stroke-width="1.5" fill="var(--color-surface-2)" stroke-dasharray="550" stroke-dashoffset="550"/>
            <g class="node-content">
              <text x="118" y="192" text-anchor="middle" fill="white" font-size="10" font-weight="600" font-family="var(--font-sans)">Data Layer</text>
              <rect x="12" y="200" width="64" height="22" rx="4" fill="var(--color-accent)" fill-opacity="0.1" stroke="var(--color-accent-light)" stroke-width="0.75" stroke-opacity="0.4"/>
              <text x="44" y="215" text-anchor="middle" fill="var(--color-text-secondary)" font-size="8" font-weight="600" font-family="var(--font-sans)">AWS</text>
              <rect x="82" y="200" width="76" height="22" rx="4" fill="var(--color-accent)" fill-opacity="0.1" stroke="var(--color-accent-light)" stroke-width="0.75" stroke-opacity="0.4"/>
              <text x="120" y="215" text-anchor="middle" fill="var(--color-text-secondary)" font-size="8" font-weight="600" font-family="var(--font-sans)">Supabase</text>
              <rect x="164" y="200" width="60" height="22" rx="4" fill="var(--color-accent)" fill-opacity="0.1" stroke="var(--color-accent-light)" stroke-width="0.75" stroke-opacity="0.4"/>
              <text x="194" y="215" text-anchor="middle" fill="var(--color-text-secondary)" font-size="8" font-weight="600" font-family="var(--font-sans)">CF D1</text>
            </g>
          </g>
